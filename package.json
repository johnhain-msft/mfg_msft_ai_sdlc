{
  "name": "mfg-msft-ai-sdlc",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative fleet manifest, security policy renderer, pipeline reconciler, bootstrap and onboarding CLIs for the AI SDLC orchestrator.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sdlc-bootstrap": "./bin/sdlc-bootstrap.mjs",
    "sdlc-onboard": "./bin/sdlc-onboard.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 tests/s1/*.test.mjs tests/s2/*.test.mjs tests/s3/*.test.mjs tests/s4/*.test.mjs tests/s5/*.test.mjs",
    "test:s1": "node --test --test-concurrency=4 tests/s1/*.test.mjs",
    "test:s2": "node --test --test-concurrency=4 tests/s2/*.test.mjs",
    "test:s3": "node --test --test-concurrency=4 tests/s3/*.test.mjs",
    "test:s4": "node --test --test-concurrency=4 tests/s4/*.test.mjs",
    "test:s5": "node --test --test-concurrency=4 tests/s5/*.test.mjs",
    "reconcile": "node src/reconcile.mjs",
    "bootstrap": "node bin/sdlc-bootstrap.mjs",
    "onboard": "node bin/sdlc-onboard.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "libsodium-wrappers": "^0.8.4",
    "yaml": "^2.8.1"
  }
}
