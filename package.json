{
  "name": "mfg-msft-ai-sdlc",
  "version": "0.1.0",
  "private": true,
  "description": "The live AI SDLC orchestrator instance: the fleet manifest, the workflows generated from it, and the scripts and tests of this fleet. The engine is the ai-sdlc-factory dependency.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 \"tests/**/*.test.mjs\"",
    "test:s1": "node --test --test-concurrency=4 tests/s1/*.test.mjs",
    "test:s2": "node --test --test-concurrency=4 tests/s2/*.test.mjs",
    "test:s3": "node --test --test-concurrency=4 tests/s3/*.test.mjs",
    "test:s4": "node --test --test-concurrency=4 tests/s4/*.test.mjs",
    "test:s5": "node --test --test-concurrency=4 tests/s5/*.test.mjs",
    "reconcile": "sdlc-reconcile",
    "bootstrap": "sdlc-bootstrap",
    "onboard": "sdlc-onboard"
  },
  "dependencies": {
    "ai-sdlc-factory": "file:../ai-sdlc-factory",
    "ajv": "^8.17.1",
    "libsodium-wrappers": "^0.8.4",
    "yaml": "^2.8.1"
  }
}
