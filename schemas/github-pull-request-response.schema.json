{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHubPullRequestResponse",
  "description": "Contract C5 response: the pull request that a drift run opened or updated. All four keys are required; further keys of the GitHub pull request object are allowed.",
  "type": "object",
  "additionalProperties": true,
  "required": ["number", "html_url", "head", "draft"],
  "properties": {
    "number": { "type": "integer", "minimum": 1 },
    "html_url": { "type": "string", "pattern": "^https?://\\S+$" },
    "head": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ref", "sha"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha": { "type": "string", "minLength": 1 }
      }
    },
    "draft": { "type": "boolean" }
  }
}
