{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sdlc-routing.schema.json",
  "title": "SDLC cross-repository routing shapes",
  "description": "The shapes that the event router (src/route-upstream.mjs) and the poll-state script (src/update-poll-state.mjs) read and write (SPEC-03): the bridge signal, the durable per-upstream state, the routing decision, the dispatch inputs and the results of the dispatch and of the mechanical cascade. The engine names no repository: every slug is data.",
  "$defs": {
    "Sha": {
      "description": "A full git object id: 40 lowercase hexadecimal characters.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "NullableSha": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Sha" }]
    },
    "RepoSlug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/(?!\\.{1,2}$)[A-Za-z0-9._-]+$"
    },
    "BranchName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "maxLength": 200
    },
    "CorrelationId": {
      "description": "1 to 128 characters of letters, digits and . _ : / + = -, starting with a letter or a digit: the same shape as the correlation id of the drift scripts.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+=-]{0,127}$"
    },
    "UtcTimestamp": {
      "description": "An ISO-8601 timestamp in UTC (the Z designator); fractional seconds are optional.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "Timestamp": {
      "description": "An ISO-8601 timestamp with the Z designator or a numeric offset.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "UpstreamMergeClientPayload": {
      "description": "UpstreamMergeSignal (a), contract C6: the client_payload of the repository_dispatch event upstream_pr_merged. Exactly these six properties; the payload only wakes the router, and merged_sha is never the target of a sync.",
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_id", "upstream_repo", "merged_sha", "pr_number", "merged_at", "default_branch"],
      "properties": {
        "correlation_id": { "$ref": "#/$defs/CorrelationId" },
        "upstream_repo": { "$ref": "#/$defs/RepoSlug" },
        "merged_sha": { "$ref": "#/$defs/Sha" },
        "pr_number": { "type": "integer", "minimum": 1 },
        "merged_at": { "$ref": "#/$defs/Timestamp" },
        "default_branch": { "$ref": "#/$defs/BranchName" }
      }
    },
    "SyncState": {
      "description": "The durable state of one upstream (SDLC_SYNC_STATE_<SLUG>): exactly 14 fields (SPEC-03 AC13). Every SHA is 40 lowercase hexadecimal characters; etag is the empty string until the first confirmed observation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "etag",
        "lastObservedHeadSha",
        "lastMergedUpstreamSha",
        "portfolioMainSha",
        "lastNoopHeadSha",
        "dismissedTargetSha",
        "failedTargetSha",
        "failedAttempts",
        "blockedTargetSha",
        "inFlightRunId",
        "inFlightTargetSha",
        "openPrTargetSha",
        "openPrNumber",
        "updatedAt"
      ],
      "properties": {
        "etag": { "type": "string" },
        "lastObservedHeadSha": { "$ref": "#/$defs/Sha" },
        "lastMergedUpstreamSha": { "$ref": "#/$defs/Sha" },
        "portfolioMainSha": { "$ref": "#/$defs/NullableSha" },
        "lastNoopHeadSha": { "$ref": "#/$defs/NullableSha" },
        "dismissedTargetSha": { "$ref": "#/$defs/NullableSha" },
        "failedTargetSha": { "$ref": "#/$defs/NullableSha" },
        "failedAttempts": { "type": "integer", "minimum": 0 },
        "blockedTargetSha": { "$ref": "#/$defs/NullableSha" },
        "inFlightRunId": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
        "inFlightTargetSha": { "$ref": "#/$defs/NullableSha" },
        "openPrTargetSha": { "$ref": "#/$defs/NullableSha" },
        "openPrNumber": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
        "updatedAt": { "$ref": "#/$defs/UtcTimestamp" }
      }
    },
    "MergeRoutingDecision": {
      "description": "Contract C6 response: one per matrix job. dispatchedWorkflowId is the workflow file that was dispatched and null for every noop-* action. plan.md C6 assigns no condition to noop-already-synced; the schema accepts it and nothing emits it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["correlationId", "upstreamRepo", "previousSha", "targetSha", "action", "dispatchedWorkflowId"],
      "properties": {
        "correlationId": { "$ref": "#/$defs/CorrelationId" },
        "upstreamRepo": { "$ref": "#/$defs/RepoSlug" },
        "previousSha": { "$ref": "#/$defs/Sha" },
        "targetSha": { "$ref": "#/$defs/Sha" },
        "action": {
          "enum": [
            "noop-304",
            "noop-already-synced",
            "noop-no-material-drift",
            "noop-unchanged-snapshot",
            "noop-dismissed-pr",
            "noop-blocked-sha",
            "dispatch-mechanical",
            "dispatch-ai-adaptation"
          ]
        },
        "dispatchedWorkflowId": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.lock\\.yml$" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["dispatch-mechanical", "dispatch-ai-adaptation"] } }, "required": ["action"] },
          "then": { "properties": { "dispatchedWorkflowId": { "type": "string" } } },
          "else": { "properties": { "dispatchedWorkflowId": { "type": "null" } } }
        }
      ]
    },
    "AiCascadeDispatchInputs": {
      "description": "The ten workflow_dispatch inputs of an AI-adaptation cascade workflow (contract C7): every value is a string.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation_id",
        "upstream_repo",
        "previous_sha",
        "upstream_sha",
        "upstream_etag",
        "upstream_pr_number",
        "downstream_repo",
        "sync_scope",
        "on_commit_only_advance",
        "dry_run"
      ],
      "properties": {
        "correlation_id": { "$ref": "#/$defs/CorrelationId" },
        "upstream_repo": { "$ref": "#/$defs/RepoSlug" },
        "previous_sha": { "$ref": "#/$defs/Sha" },
        "upstream_sha": { "$ref": "#/$defs/Sha" },
        "upstream_etag": { "type": "string" },
        "upstream_pr_number": { "type": "string", "pattern": "^(?:[1-9][0-9]*)?$" },
        "downstream_repo": { "$ref": "#/$defs/RepoSlug" },
        "sync_scope": { "enum": ["both", "workshop-only", "studio-only", "showcase-runs", "github-intermediate"] },
        "on_commit_only_advance": { "enum": ["noop", "bump-provenance"] },
        "dry_run": { "type": "string" }
      }
    },
    "MechanicalDispatchInputs": {
      "description": "The eight workflow_dispatch inputs of the mechanical cascade workflow (SPEC-03 AC65): the ten of AiCascadeDispatchInputs without sync_scope and on_commit_only_advance.",
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_id", "upstream_repo", "previous_sha", "upstream_sha", "upstream_etag", "upstream_pr_number", "downstream_repo", "dry_run"],
      "properties": {
        "correlation_id": { "$ref": "#/$defs/CorrelationId" },
        "upstream_repo": { "$ref": "#/$defs/RepoSlug" },
        "previous_sha": { "$ref": "#/$defs/Sha" },
        "upstream_sha": { "$ref": "#/$defs/Sha" },
        "upstream_etag": { "type": "string" },
        "upstream_pr_number": { "type": "string", "pattern": "^(?:[1-9][0-9]*)?$" },
        "downstream_repo": { "$ref": "#/$defs/RepoSlug" },
        "dry_run": { "type": "string" }
      }
    },
    "WorkflowDispatchRunDetails": {
      "description": "The 200 response of POST .../actions/workflows/{workflow_id}/dispatches with return_run_details: true (REST API version 2022-11-28).",
      "type": "object",
      "required": ["workflow_run_id", "run_url", "html_url"],
      "properties": {
        "workflow_run_id": { "type": "integer", "minimum": 1 },
        "run_url": { "type": "string", "minLength": 1 },
        "html_url": { "type": "string", "minLength": 1 }
      }
    },
    "PortfolioMechanicalCascadeResult": {
      "description": "Contract C8 response: what src/update-poll-state.mjs prints after it verified the open pull request of a mechanical cascade.",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "prNumber", "prUrl", "headSha", "openPrTargetSha"],
      "properties": {
        "outcome": { "enum": ["pr-opened", "pr-updated"] },
        "prNumber": { "type": "integer", "minimum": 1 },
        "prUrl": { "type": "string", "minLength": 1 },
        "headSha": { "$ref": "#/$defs/Sha" },
        "openPrTargetSha": { "$ref": "#/$defs/Sha" }
      }
    },
    "NoopNoChangesResult": {
      "description": "What src/update-poll-state.mjs prints when the agent committed nothing (AC47).",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": { "outcome": { "const": "noop-no-changes" } }
    },
    "ManifestEdge": {
      "description": "The part of a dependencyEdges entry of sdlc.yaml that the scripts of S3 read: the entry that a --slug names, and the repositories and branches that a repository_dispatch signal is matched against. The manifest itself is validated by schemas/sdlc.schema.json when it is reconciled; keys beyond these are ignored.",
      "type": "object",
      "required": ["edgeId", "upstreamRepo", "upstreamKey", "upstreamSlug", "upstreamDefaultBranch", "downstreamRepo", "mode", "stateVariable", "provenanceJsonPointer"],
      "properties": {
        "edgeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "upstreamRepo": { "$ref": "#/$defs/RepoSlug" },
        "upstreamKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "upstreamSlug": { "type": "string", "pattern": "^[A-Z0-9_]{1,64}$" },
        "upstreamDefaultBranch": { "$ref": "#/$defs/BranchName" },
        "downstreamRepo": { "$ref": "#/$defs/RepoSlug" },
        "mode": { "enum": ["mechanical", "ai-adaptation"] },
        "stateVariable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 255 },
        "provenanceJsonPointer": { "type": "string", "pattern": "^(?:/(?:[^/~]|~[01])*)+$" },
        "syncScopes": { "type": "array", "items": { "enum": ["both", "workshop-only", "studio-only", "showcase-runs", "github-intermediate"] } },
        "installDirectories": { "type": "array", "items": { "type": "string" } }
      }
    },
    "RouterEdge": {
      "description": "The dependency edge that the router job receives as EDGE_JSON (toJSON(matrix) of its matrix entry): the 19 keys of contract C3 plus edgeId and preflightCommands (SPEC-01 AC33). Keys beyond these are ignored.",
      "type": "object",
      "required": [
        "edgeId",
        "upstreamRepo",
        "upstreamKey",
        "upstreamSlug",
        "upstreamDefaultBranch",
        "initialBaselineSha",
        "downstreamRepo",
        "mode",
        "schedule",
        "onCommitOnlyAdvance",
        "stateVariable",
        "provenanceFile",
        "provenanceJsonPointer",
        "onBots",
        "branchName",
        "closeOlderKey",
        "reviewers",
        "importCommands",
        "preflightCommands",
        "buildCommands",
        "verifyCommands"
      ],
      "properties": {
        "edgeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "upstreamRepo": { "$ref": "#/$defs/RepoSlug" },
        "upstreamKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "upstreamSlug": { "type": "string", "pattern": "^[A-Z0-9_]{1,64}$" },
        "upstreamDefaultBranch": { "$ref": "#/$defs/BranchName" },
        "initialBaselineSha": { "$ref": "#/$defs/Sha" },
        "downstreamRepo": { "$ref": "#/$defs/RepoSlug" },
        "mode": { "enum": ["mechanical", "ai-adaptation"] },
        "schedule": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "onCommitOnlyAdvance": { "enum": ["noop", "bump-provenance"] },
        "stateVariable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 255 },
        "provenanceFile": { "type": "string", "minLength": 1 },
        "provenanceJsonPointer": { "type": "string", "pattern": "^(?:/(?:[^/~]|~[01])*)+$" },
        "onBots": { "type": "array", "items": { "type": "string" } },
        "branchName": { "$ref": "#/$defs/BranchName" },
        "closeOlderKey": { "type": "string", "minLength": 1 },
        "reviewers": { "type": "array", "items": { "type": "string" } },
        "importCommands": { "type": "array", "items": { "type": "string" } },
        "preflightCommands": { "type": "array", "items": { "type": "string" } },
        "buildCommands": { "type": "array", "items": { "type": "string" } },
        "verifyCommands": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
