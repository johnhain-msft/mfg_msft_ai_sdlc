{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SDLC fleet manifest",
  "description": "Declarative fleet manifest (sdlc.yaml): any number of projects and directed dependency edges. The engine is repository-agnostic; the reference fleet is preset data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["projects"],
  "properties": {
    "projects": {
      "description": "Any number of project entries, each declaring an arbitrary <owner>/<repo>. Two entries may name the same repository.",
      "type": "array",
      "items": { "$ref": "#/definitions/project" }
    },
    "dependencyEdges": {
      "description": "Directed edges from an upstream repository to a downstream repository; fan-in, fan-out and multi-hop chains are valid.",
      "type": "array",
      "default": [],
      "items": { "$ref": "#/definitions/edge" }
    },
    "protectedFilesExclude": {
      "description": "Basenames, path prefixes or '/'-rooted exact paths or globs that drift and onboarding handlers exclude from the protected-files policy.",
      "type": "array",
      "default": [],
      "items": { "$ref": "#/definitions/protectedFilesEntry" }
    },
    "engineApiKeySecret": {
      "description": "Name of the secret that holds the engine API key when engineAuthMode is api-key.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    }
  },
  "definitions": {
    "repoSlug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/(?!\\.{1,2}$)[A-Za-z0-9._-]+$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+$"
    },
    "globEntry": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.@+*/-]+$"
    },
    "protectedFilesEntry": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.@+*/-]+$"
    },
    "cron": {
      "type": "string",
      "pattern": "^[0-9A-Za-z*/,?#-]+(?: [0-9A-Za-z*/,?#-]+){4}$"
    },
    "commandList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectKey", "repo", "defaultBranch", "driftAudit"],
      "properties": {
        "projectKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "repo": { "$ref": "#/definitions/repoSlug" },
        "defaultBranch": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$", "maxLength": 200 },
        "driftAudit": { "$ref": "#/definitions/driftAudit" },
        "deconflictInRepoSchedules": {
          "enum": ["none", "disable-workflow-schedules"],
          "default": "none"
        },
        "deconflictWorkflowIds": {
          "type": "array",
          "default": [],
          "items": { "type": "string", "minLength": 1 }
        },
        "autoMerge": { "const": false }
      },
      "if": {
        "required": ["deconflictInRepoSchedules"],
        "properties": { "deconflictInRepoSchedules": { "const": "disable-workflow-schedules" } }
      },
      "then": {
        "required": ["deconflictWorkflowIds"],
        "properties": { "deconflictWorkflowIds": { "type": "array", "minItems": 1 } }
      },
      "else": {
        "properties": { "deconflictWorkflowIds": { "type": "array", "maxItems": 0 } }
      }
    },
    "driftAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "schedule",
        "upkeepStrategy",
        "instructions",
        "instructionsFile",
        "knowledgeSources",
        "buildCommands",
        "verifyCommands",
        "draft",
        "reviewers"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "$ref": "#/definitions/cron" },
        "upkeepStrategy": {
          "enum": [
            "content-and-docs-sync",
            "dependency-and-pattern-modernization",
            "code-quality-and-improvement-scan",
            "custom"
          ]
        },
        "instructions": { "type": "string" },
        "instructionsFile": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/relativePath" }]
        },
        "knowledgeSources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["watchUrls", "packageManifests", "mcpServers"],
          "properties": {
            "watchUrls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["url", "label", "kind"],
                "properties": {
                  "url": { "type": "string" },
                  "label": { "type": "string" },
                  "kind": { "enum": ["changelog", "blog", "docs", "release-notes", "feed"] }
                }
              }
            },
            "packageManifests": { "type": "array", "items": { "type": "string" } },
            "mcpServers": { "type": "object" },
            "citedPages": {
              "description": "Optional: documentation pages that the target's own files cite. The snapshot step reads every file of the target checkout that matches an include pattern, collects the URLs on the listed hosts that they cite, and snapshots the text of the most cited pages (at most maxPages, default 50), so that a run can tell which cited page changed since the previous one. The hosts are added to network.allowed.",
              "type": "object",
              "additionalProperties": false,
              "required": ["include", "hosts"],
              "properties": {
                "include": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/globEntry" } },
                "hosts": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$" }
                },
                "maxPages": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
              }
            }
          }
        },
        "buildCommands": { "$ref": "#/definitions/commandList" },
        "verifyCommands": { "$ref": "#/definitions/commandList" },
        "draft": { "type": "boolean" },
        "reviewers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "agentSandbox": {
          "description": "Optional: what the agent of the project's drift workflow has inside its sandbox besides what every drift workflow gives it (git, node and the executables of the build commands). installDependencies runs npm ci --ignore-scripts in the target checkout before the agent starts, so that the validators that the agent runs find their packages although the sandbox has no route to the package registry. bashCommands adds executables, each one a bare command name, to the bash allowlist of the agent.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "installDependencies": { "type": "boolean", "default": false },
            "bashCommands": {
              "type": "array",
              "uniqueItems": true,
              "default": [],
              "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]*$" }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "upstreamRepo",
        "upstreamKey",
        "upstreamSlug",
        "upstreamDefaultBranch",
        "initialBaselineSha",
        "downstreamRepo",
        "mode",
        "schedule",
        "onCommitOnlyAdvance",
        "stateVariable",
        "provenanceFile",
        "provenanceJsonPointer",
        "branchName",
        "closeOlderKey",
        "reviewers",
        "importCommands",
        "preflightCommands",
        "acceptCommands",
        "buildCommands",
        "verifyCommands",
        "adaptationInstructions",
        "allowedFiles",
        "protectedFilesExclude",
        "autoMerge",
        "immutableGates"
      ],
      "properties": {
        "edgeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "upstreamRepo": { "$ref": "#/definitions/repoSlug" },
        "upstreamKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "upstreamSlug": { "type": "string", "pattern": "^[A-Z0-9_]{1,64}$" },
        "upstreamDefaultBranch": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$", "maxLength": 200 },
        "initialBaselineSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "downstreamRepo": { "$ref": "#/definitions/repoSlug" },
        "mode": { "enum": ["mechanical", "ai-adaptation"] },
        "schedule": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/cron" }]
        },
        "onCommitOnlyAdvance": { "enum": ["noop", "bump-provenance"] },
        "stateVariable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "provenanceFile": { "$ref": "#/definitions/relativePath" },
        "provenanceJsonPointer": { "type": "string", "pattern": "^(?:/(?:[^/~]|~[01])*)+$" },
        "branchName": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]*[A-Za-z0-9_-]$",
          "maxLength": 200
        },
        "closeOlderKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "reviewers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "importCommands": { "$ref": "#/definitions/commandList" },
        "preflightCommands": { "$ref": "#/definitions/commandList" },
        "acceptCommands": { "$ref": "#/definitions/commandList" },
        "buildCommands": { "$ref": "#/definitions/commandList" },
        "verifyCommands": { "$ref": "#/definitions/commandList" },
        "adaptationInstructions": { "type": "string" },
        "allowedFiles": { "type": "array", "items": { "$ref": "#/definitions/globEntry" } },
        "protectedFilesExclude": { "type": "array", "items": { "$ref": "#/definitions/protectedFilesEntry" } },
        "maxPatchFiles": {
          "description": "Optional largest number of files that one cascade pull request may change, rendered as create-pull-request max-patch-files; the handler refuses a larger patch, and its own limit is 100 when this is omitted.",
          "type": "integer",
          "minimum": 1
        },
        "autoMerge": { "const": false },
        "syncScopes": {
          "description": "Optional list of workflow_dispatch sync_scope values that an ai-adaptation workflow accepts; all five members are accepted when omitted.",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["both", "workshop-only", "studio-only", "showcase-runs", "github-intermediate"] }
        },
        "installDirectories": {
          "description": "Optional directories of the downstream checkout, relative to its root, in which a cascade workflow runs npm ci --include=dev; defaults to the root only.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/relativePath" }
        },
        "pythonVersion": {
          "description": "Optional Python version for Python-based downstream repositories; when set, cascade setup installs Python and runs pip install -e .[dev] instead of npm ci.",
          "type": "string",
          "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
        },
        "immutableGates": { "$ref": "#/definitions/immutableGates" },
        "adaptation": { "$ref": "#/definitions/adaptation" }
      }
    },
    "adaptation": {
      "description": "Optional data of an ai-adaptation edge that the helper commands and the run report read (SPEC-04): the file names of the preflight reports, the path of the studio manifest, the revision-pin literals and the globs of the files that the pull-request result reports.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preflightReports": {
          "description": "File names, under the artifact directory of the run, of the reports of the preflightCommands, in the order of the commands (each report is also kept as preflight-<n>.txt).",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
        },
        "labStudioDrift": {
          "description": "Data of the studio drift helper.",
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest"],
          "properties": {
            "manifest": { "$ref": "#/definitions/relativePath" }
          }
        },
        "revisionPins": {
          "description": "Data of the revision-pin helper: where the prior revisions are recorded, which files carry the pins, and which constant must hold the new revision afterwards.",
          "type": "object",
          "additionalProperties": false,
          "required": ["provenance", "files", "constant"],
          "properties": {
            "provenance": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "pointer"],
                "properties": {
                  "file": { "$ref": "#/definitions/relativePath" },
                  "pointer": { "type": "string", "pattern": "^(?:/(?:[^/~]|~[01])*)+$" }
                }
              }
            },
            "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/relativePath" } },
            "constant": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "name"],
              "properties": {
                "file": { "$ref": "#/definitions/relativePath" },
                "name": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
              }
            }
          }
        },
        "pullRequestResult": {
          "description": "Globs of the changed files that the pull-request result names: the base names of the matches, without their extension, sorted.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adaptedModules": { "$ref": "#/definitions/globEntry" },
            "adaptedStudioLabs": { "$ref": "#/definitions/globEntry" }
          }
        }
      }
    },
    "immutableGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zeroDiffPaths"],
      "properties": {
        "zeroDiffPaths": { "type": "array", "items": { "$ref": "#/definitions/globEntry" } },
        "lockedTestBlocks": {},
        "inProcessInvariants": {}
      }
    }
  }
}
