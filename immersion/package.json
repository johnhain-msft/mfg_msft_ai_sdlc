{
  "name": "ai-sdlc-immersion-presentation",
  "version": "0.1.0",
  "private": true,
  "description": "Scaling the Agentic SDLC — What is AI SDLC interactive presentation, synchronized speaker view, script book, and PDF handout",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
